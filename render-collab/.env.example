PORT=10000
HOST=0.0.0.0
SERVICE_NAME=RTF collab relay

# Comma-separated browser origins allowed to open websocket connections.
# Leave blank to allow any origin.
ALLOWED_ORIGINS=https://your-github-pages-site.example

# Optional diagnostics.
LOG_CONNECTIONS=false

# Optional tuning.
MAX_MESSAGE_BYTES=262144
ROOM_IDLE_TTL_MS=1800000
